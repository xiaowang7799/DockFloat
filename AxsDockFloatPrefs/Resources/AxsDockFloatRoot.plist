<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>Dock浮动</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>动效</string>
            <key>footerText</key><string>模式互斥：点亮任意一项即切换，无需重启桌面。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>浮动</string>
            <key>key</key><string>mode_float</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>翻滚</string>
            <key>key</key><string>mode_roll</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>抖动</string>
            <key>key</key><string>mode_shake</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>随机抖动</string>
            <key>key</key><string>mode_random</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>鱼缸游鱼</string>
            <key>key</key><string>mode_fish</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsDockFloatSliderCell</string>
            <key>label</key><string>幅度</string>
            <key>key</key><string>amplitude</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.2</real>
            <key>max</key><real>3.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsDockFloatSliderCell</string>
            <key>label</key><string>周期(秒)</string>
            <key>key</key><string>period</string>
            <key>defaults</key><string>com.axs.dockfloat</string>
            <key>default</key><real>2.0</real>
            <key>min</key><real>0.5</real>
            <key>max</key><real>6.0</real>
        </dict>
    </array>
</dict>
</plist>
